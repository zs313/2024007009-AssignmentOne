<?xml version="1.0" encoding="utf-8"?>
<!-- State-specific items must precede the default item. Focus is visible for keyboard users. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@color/light_green" />
    <item android:state_focused="true" android:drawable="@color/light_green" />
    <item android:drawable="@color/green" />
</selector>
