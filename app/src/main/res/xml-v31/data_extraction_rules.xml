<?xml version="1.0" encoding="utf-8"?>
<!-- This app only displays bundled course data and has no user data to transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
